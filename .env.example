# Generate a long random value. Never commit the real value.
SECRET_KEY=replace-with-a-long-random-secret

# Prices come only from the connected Excel workbook.
DEMO_MODE=false
ENABLE_SCHEDULER=true
REFRESH_INTERVAL_MINUTES=30
MANUAL_REFRESH_COOLDOWN_SECONDS=600
STALE_AFTER_MINUTES=180
PROVIDER_TIMEOUT_SECONDS=15
MAX_UPLOAD_BYTES=20971520

# Local default is instance/bunker-market-monitor.db.
# Render persistent disk path:
DATABASE_PATH=/var/data/bunker-market-monitor.db
SESSION_COOKIE_SECURE=true

# Microsoft Entra / Graph workbook connector
MSAL_CLIENT_ID=
MSAL_CLIENT_SECRET=
MSAL_TENANT=common
MSAL_REDIRECT_URI=http://localhost:5070/auth/callback
GRAPH_REFRESH_INTERVAL_MINUTES=5
