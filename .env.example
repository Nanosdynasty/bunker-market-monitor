# Generate a long random value. Never commit the real value.
SECRET_KEY=replace-with-a-long-random-secret

# Keep true until both providers are configured and verified.
DEMO_MODE=true
ENABLE_SCHEDULER=true
REFRESH_INTERVAL_MINUTES=30
MANUAL_REFRESH_COOLDOWN_SECONDS=600
STALE_AFTER_MINUTES=180
PROVIDER_TIMEOUT_SECONDS=15

# Bulugo: create a key in Dashboard > Developer Settings.
BULUGO_API_KEY=
BULUGO_API_URL=https://my.bulugo.com/api/v1/prices
BULUGO_DAILY_QUOTA=100

# OilPriceAPI: dataset access depends on account entitlement.
OILPRICEAPI_KEY=
OILPRICEAPI_URL=https://api.oilpriceapi.com/v1/bunker-fuels/all
OILPRICEAPI_DAILY_QUOTA=50

# Local default is instance/bunker-market-monitor.db.
# Render persistent disk path:
DATABASE_PATH=/var/data/bunker-market-monitor.db
SESSION_COOKIE_SECURE=true
